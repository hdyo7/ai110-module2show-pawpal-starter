classDiagram
    class task {
        +string description
        +string frequency
        +integer duration_minutes
        +pet pet
        +time preferred_time
        +datetime[] completed_occurrences
        +mark_complete(occurrence: datetime) void
    }

    class pet {
        +string name
        +string species
        +task[] tasks
        +add_task(new_task: task) void
    }

    class owner {
        +string name
        +pet[] pets
        +get_all_tasks() task[]
    }

    class scheduler {
        +create_schedule(owner: owner) task[]
    }

    owner "1" o-- "0..*" pet : manages
    pet "1" *-- "0..*" task : stores
    task "0..*" --> "1" pet : belongs to
    scheduler ..> owner : calls get_all_tasks()
    scheduler ..> task : organizes into a schedule