classDiagram
    class Task {
        +string description
        +string frequency
        +integer duration_minutes
        +Pet | None pet
        +time preferred_time
        +datetime[] completed_occurrences
        +mark_complete(occurrence: datetime) void
    }

    class Pet {
        +string name
        +string species
        +Task[] tasks
        +add_task(new_task: Task) void
    }

    class Owner {
        +string name
        +Pet[] pets
        +add_pet(new_pet: Pet) void
        +get_all_tasks() Task[]
    }

    class Scheduler {
        +create_schedule(owner: Owner) Task[]
    }

    Owner "1" o-- "0..*" Pet : manages
    Pet "0..1" -- "0..*" Task : stores
    Scheduler ..> Owner : calls get_all_tasks()
    Scheduler ..> Task : timed tasks first by preferred_time, untimed last