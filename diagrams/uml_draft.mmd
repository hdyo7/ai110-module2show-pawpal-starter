classDiagram
    class task {
        +string description
        +datetime time
        +string frequency
        +boolean completed
        +mark_complete() void
    }

    class pet {
        +string name
        +string species
        +task[] tasks
    }

    class owner {
        +string name
        +pet[] pets
        +get_all_tasks() task[]
    }

    class scheduler {
        +create_schedule(owner: owner) task[]
    }

    owner "1" o-- "0..*" pet : manages
    pet "1" *-- "0..*" task : stores
    scheduler ..> owner : calls get_all_tasks()
    scheduler ..> task : organizes into a schedule